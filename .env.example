APP_NAME="Graha Pondasi ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
VISIBLE_MODULES=manufacturing,accounting
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=grahapondasi
DB_USERNAME=root
DB_PASSWORD=
MYSQLDUMP_BINARY=mysqldump
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Disk evidence foto lapangan: local | r2 (S3-compatible)
EVIDENCE_DISK=local
DOCUMENT_DISK=local

# Generic S3-compatible fallback (preferred for new deployments).
# Company Storage Profile configured in UI takes precedence over these values.
OBJECT_STORAGE_DISK=object-storage
OBJECT_STORAGE_KEY=
OBJECT_STORAGE_SECRET=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_URL=
OBJECT_STORAGE_PATH_STYLE=true
OBJECT_STORAGE_ALLOW_PRIVATE_ENDPOINTS=false

# Object storage S3-compatible (Cloudflare R2) � kosongkan bila pakai local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET=
R2_ENDPOINT=
R2_USE_PATH_STYLE_ENDPOINT=true
QUEUE_CONNECTION=database

# === Demo dataset (ADR-079) ===
# db:seed otomatis menjalankan demo dataset HANYA di local/demo + flag ini aktif.
# Production TIDAK PERNAH men-seed demo data apa pun nilainya.
SEED_DEMO_DATA=false
# true = evidence binary demo ikut dikirim ke EVIDENCE_DISK (mis. S3).
# false (default) = file binary demo hanya ke disk lokal.
DEMO_SEED_STORAGE=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Documentation screenshots disk (LOCAL ONLY - jangan arahkan ke S3/R2)
DOCS_DISK=docs
